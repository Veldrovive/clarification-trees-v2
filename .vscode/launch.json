{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Test vLLM Server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/clarification_trees/__main__.py",
            "console": "integratedTerminal",
            "args": "test-vllm-server"
        },
        {
            "name": "Python Debugger: Visualize Tree",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/visualize_trees.py",
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/data/trees/single_tree_test/tree.json"
            ]
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}